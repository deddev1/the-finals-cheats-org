---
import BlogPostPage from '../../../../components/BlogPostPage.astro';
import { blogPosts, getPostBySlug, resolvePost } from '../../../../data/blog/helpers';
import { defaultLocale, isLocaleCode, localeCodes, type LocaleCode } from '../../../../data/i18n/locales';

export function getStaticPaths() {
	const paths: {
		params: { lang: string; slug: string };
		props: { locale: LocaleCode; post: ReturnType<typeof resolvePost> };
	}[] = [];

	for (const locale of localeCodes) {
		if (locale === defaultLocale) continue;
		for (const post of blogPosts) {
			const resolved = resolvePost(post, locale);
			paths.push({
				params: { lang: locale, slug: resolved.translation.slug },
				props: { locale, post: resolved },
			});
		}
	}

	return paths;
}

const { locale, post } = Astro.props;
const slug = Astro.params.slug ?? '';

if (!isLocaleCode(Astro.params.lang ?? '')) {
	return Astro.redirect('/blog/', 301);
}

const live = getPostBySlug(locale, slug) ?? post;
---

<BlogPostPage locale={locale} post={live} />

---
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';
import { productScreenshots } from '../data/product-images';
import { contentSrcSet } from '../lib/responsive-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getT(locale);
const homeHref = getLocalizedPath('home', locale);
const espHref = getLocalizedPath('finals-esp', locale);
const aimbotHref = getLocalizedPath('finals-aimbot', locale);
const updatesHref = getLocalizedPath('updates', locale);
const preview = productScreenshots[0]!;
---

<section class="shell home__prose home__prose--en" aria-labelledby="home-about-title">
	<div class="home__about-grid">
		<div class="home__prose-callout">
			<p id="home-about-title" class="home__prose-kicker">
				{t('home.aboutTitle')}
			</p>
			<p>{t('home.aboutP1')}</p>
			<div class="home__about-actions">
				<a class="home__about-pricing" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
					{t('home.aboutPricingCta')}
				</a>
			</div>
			<p>
				{t('home.aboutP2Before')}{' '}
				<a href={homeHref}>{t('home.aboutPillar')}</a>
				{t('home.aboutP2Mid')}
				<a href={espHref}>{t('home.aboutEsp')}</a>
				{t('home.aboutP2Mid')}
				<a href={aimbotHref}>{t('home.aboutAimbot')}</a>
				{t('home.aboutP2Or')}
				<a href={updatesHref}>{t('home.aboutUndetected')}</a>
				{t('home.aboutP2After')}
			</p>
		</div>

		<figure class="home__about-media">
			<img
				class="home__about-image"
				src={preview.src}
				srcset={contentSrcSet(preview.src)}
				sizes="(max-width: 768px) 17rem, 19.5rem"
				alt={preview.alt}
				width="640"
				height="398"
				loading="lazy"
				decoding="async"
			/>
			<figcaption class="home__about-caption">{preview.caption}</figcaption>
		</figure>
	</div>
</section>

<style is:global>
	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home__about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(11rem, 19.5rem);
		gap: clamp(1rem, 2.5vw, 1.75rem);
		align-items: start;
	}

	.home__about-media {
		margin: 0;
		width: 100%;
		max-width: 19.5rem;
		justify-self: end;
	}

	.home__about-image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
	}

	.home__about-caption {
		margin: 0.45rem 0 0;
		font-size: 0.72rem;
		line-height: 1.4;
		color: var(--ink-faint);
	}

	.home__prose-callout {
		max-width: 42rem;
		padding-left: 1.1rem;
		border-left: 3px solid var(--magenta);
	}

	.home__prose-kicker {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home__prose-callout p {
		margin: 0 0 0.75rem;
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose-callout p:last-child {
		margin-bottom: 0;
	}

	.home__about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin: 0 0 0.85rem;
	}

	.home__about-pricing {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.72rem 1.15rem;
		border-radius: 0.75rem;
		border: 1px solid var(--line-strong);
		background: var(--bg-elevated);
		color: var(--ink);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.home__about-pricing:hover {
		border-color: color-mix(in srgb, var(--magenta) 40%, var(--line-strong));
		color: var(--magenta-soft);
		transform: translateY(-1px);
	}

	.home__prose--en a:not(.home__about-pricing) {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:not(.home__about-pricing):hover {
		color: var(--ink);
	}

	@media (max-width: 768px) {
		.home__about-grid {
			grid-template-columns: 1fr;
		}

		.home__about-media {
			max-width: 17rem;
			justify-self: start;
		}
	}
</style>

---
import { demoVideo } from '../data/media';
import { getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getT(locale);
const pricingHref = getLocalizedPath('pricing', locale);
const homeHref = getLocalizedPath('home', locale);
const espHref = getLocalizedPath('rust-esp', locale);
const aimbotHref = getLocalizedPath('rust-aimbot', locale);
const updatesHref = getLocalizedPath('updates', locale);
---

<section class="shell home__prose home__prose--en" aria-labelledby="home-about-title">
	<div class="home__about-grid">
		<div class="home__prose-callout">
			<h2 id="home-about-title" class="home__prose-kicker">
				{t('home.aboutTitle')}
			</h2>
			<p>{t('home.aboutP1')}</p>
			<div class="home__about-actions">
				<a class="home__about-pricing" href={pricingHref}>
					{t('home.aboutPricingCta')}
				</a>
			</div>
			<p>
				{t('home.aboutP2Before')}{' '}
				<a href={homeHref}>{t('home.aboutPillar')}</a>
				{t('home.aboutP2Mid')}
				<a href={espHref}>{t('home.aboutEsp')}</a>
				{t('home.aboutP2Mid')}
				<a href={aimbotHref}>{t('home.aboutAimbot')}</a>
				{t('home.aboutP2Or')}
				<a href={updatesHref}>{t('home.aboutUndetected')}</a>
				{t('home.aboutP2After')}
			</p>
		</div>

		<figure class="home__about-media">
			<div class="home__video-wrap" data-demo-video>
				<video
					class="home__video"
					width={demoVideo.width}
					height={demoVideo.height}
					preload="metadata"
					playsinline
					poster={demoVideo.poster}
					aria-label={demoVideo.title}
				>
					<source src={demoVideo.src} type="video/mp4" />
				</video>
				<button
					type="button"
					class="home__video-play"
					data-demo-video-play
					aria-label={`${t('media.playVideo')}: ${t('media.demoVideoTitle')}`}
				>
					<span class="home__video-play-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="currentColor">
							<path d="M8 5.14v13.72L19 12 8 5.14z"></path>
						</svg>
					</span>
				</button>
			</div>
			<figcaption class="home__video-caption">{t('media.demoVideoTitle')}</figcaption>
		</figure>
	</div>
</section>

<script>
	function initDemoVideos() {
		for (const wrap of document.querySelectorAll('[data-demo-video]')) {
			if (wrap.getAttribute('data-demo-video-ready') === 'true') continue;
			wrap.setAttribute('data-demo-video-ready', 'true');

			const video = wrap.querySelector('video');
			const playBtn = wrap.querySelector('[data-demo-video-play]');
			if (!(video instanceof HTMLVideoElement) || !(playBtn instanceof HTMLButtonElement)) continue;

			video.playsInline = true;

			const showOverlay = () => {
				playBtn.hidden = false;
			};
			const hideOverlay = () => {
				playBtn.hidden = true;
			};

			const startPlayback = async () => {
				try {
					video.controls = true;
					hideOverlay();
					await video.play();
				} catch {
					video.controls = false;
					video.pause();
					showOverlay();
				}
			};

			playBtn.addEventListener('click', (event) => {
				event.preventDefault();
				event.stopPropagation();
				void startPlayback();
			});

			video.addEventListener('click', () => {
				if (video.paused) void startPlayback();
			});

			video.addEventListener('play', hideOverlay);
			video.addEventListener('pause', () => {
				if (!video.ended) showOverlay();
			});
			video.addEventListener('ended', () => {
				video.controls = false;
				showOverlay();
			});
		}
	}

	initDemoVideos();
	document.addEventListener('astro:page-load', initDemoVideos);
</script>

<style is:global>
	.home__prose--en {
		padding-block: clamp(2rem, 4vw, 2.75rem) 0.5rem;
		border-bottom: 1px solid var(--line-soft);
	}

	.home__about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(11rem, 19.5rem);
		gap: clamp(1rem, 2.5vw, 1.75rem);
		align-items: start;
	}

	.home__about-media {
		margin: 0;
		width: 100%;
		max-width: 19.5rem;
		justify-self: end;
	}

	.home__video-wrap {
		position: relative;
		border-radius: var(--radius-md, 0.75rem);
		overflow: hidden;
		border: 1px solid var(--line);
		background: #000;
		aspect-ratio: 16 / 9;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
	}

	.home__video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		vertical-align: middle;
		cursor: pointer;
	}

	.home__video-play {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: grid;
		place-items: center;
		margin: 0;
		padding: 0;
		border: 0;
		background: linear-gradient(180deg, rgba(7, 7, 7, 0.08), rgba(7, 7, 7, 0.42));
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.home__video-play[hidden] {
		display: none;
	}

	.home__video-play:hover {
		background: linear-gradient(180deg, rgba(7, 7, 7, 0.12), rgba(7, 7, 7, 0.5));
	}

	.home__video-play-icon {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--magenta) 92%, #000);
		color: #fff;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.home__video-play-icon svg {
		width: 1.35rem;
		height: 1.35rem;
		margin-left: 0.15rem;
	}

	.home__video-play:hover .home__video-play-icon {
		transform: scale(1.06);
		background: var(--accent-hover);
	}

	.home__video-caption {
		margin: 0.45rem 0 0;
		font-size: 0.72rem;
		line-height: 1.4;
		color: var(--ink-faint);
	}

	.home__prose-callout {
		max-width: 42rem;
		padding-left: 1.1rem;
		border-left: 3px solid var(--magenta);
	}

	.home__prose-kicker {
		margin: 0 0 0.7rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--magenta-soft);
	}

	.home__prose-callout p {
		margin: 0 0 0.75rem;
		color: var(--ink-muted);
		line-height: 1.65;
		font-size: 0.9375rem;
	}

	.home__prose-callout p:last-child {
		margin-bottom: 0;
	}

	.home__about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin: 0 0 0.85rem;
	}

	.home__about-pricing {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.72rem 1.15rem;
		border-radius: 0.75rem;
		border: 1px solid var(--line-strong);
		background: var(--bg-elevated);
		color: var(--ink);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}

	.home__about-pricing:hover {
		border-color: color-mix(in srgb, var(--magenta) 40%, var(--line-strong));
		color: var(--magenta-soft);
		transform: translateY(-1px);
	}

	.home__prose--en a:not(.home__about-pricing) {
		color: var(--magenta-soft);
		font-weight: 600;
		text-decoration: none;
	}

	.home__prose--en a:not(.home__about-pricing):hover {
		color: var(--ink);
	}

	@media (max-width: 768px) {
		.home__about-grid {
			grid-template-columns: 1fr;
		}

		.home__about-media {
			max-width: 17rem;
			justify-self: start;
		}
	}
</style>

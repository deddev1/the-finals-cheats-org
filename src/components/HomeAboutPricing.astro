---
import { productInfo, siteConfig } from '../data/site';
import type { LocaleCode } from '../data/i18n/locales';
import { getT } from '../i18n/server';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const t = getT(locale);
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const lifetime = productInfo.plans.find((p) => p.id === 'lifetime') ?? productInfo.plans[1];
---

<aside class="home__about-pricing" aria-label={t('product.plans')}>
	<div class="home__about-pricing-grid price-grid">
		<article class="home__price-card price-card">
			<p class="home__price-card-label">{t('product.monthly')}</p>
			<p class="home__price-card-price">
				<span class="home__price-card-amount">${monthly.price}</span>
				<span class="home__price-card-meta">{t('product.perMonth')}</span>
			</p>
			<p class="home__price-card-note">{t('product.days30')}</p>
			<a class="home__price-card-cta" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
				{t('product.buyMonthly')}
			</a>
		</article>

		<article class="home__price-card price-card is-featured">
			<p class="home__price-card-label">{t('product.lifetime')}</p>
			<p class="home__price-card-price">
				<span class="home__price-card-amount">${lifetime.price}</span>
				<span class="home__price-card-meta">{t('product.once')}</span>
			</p>
			<p class="home__price-card-note">{t('product.oneTime')}</p>
			<a class="home__price-card-cta home__price-card-cta--solid" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
				{t('product.buyLifetime')}
			</a>
		</article>
	</div>
</aside>

<style>
	.home__about-pricing {
		width: 100%;
		max-width: 19.5rem;
		justify-self: end;
	}

	.home__about-pricing-grid {
		display: grid;
		grid-template-rows: 1fr 1fr;
		grid-template-columns: 1fr;
		gap: 0.55rem;
		height: 100%;
		min-height: 15.5rem;
		margin-top: 0;
	}

	.home__price-card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 0.2rem;
		padding: 0.85rem 0.9rem 0.8rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-md, 0.75rem);
		background: var(--bg-panel);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
	}

	.home__price-card.is-featured {
		border-color: color-mix(in srgb, var(--magenta) 42%, var(--line));
		background: color-mix(in srgb, var(--magenta) 10%, var(--bg-panel));
	}

	.home__price-card-label {
		margin: 0;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.home__price-card-price {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
	}

	.home__price-card-amount {
		font-family: var(--font-display);
		font-size: 1.65rem;
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1;
		color: var(--ink);
	}

	.home__price-card.is-featured .home__price-card-amount {
		color: var(--magenta-soft);
	}

	.home__price-card-meta {
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.home__price-card-note {
		margin: 0;
		font-size: 0.74rem;
		color: var(--ink-muted);
	}

	.home__price-card-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 2.15rem;
		margin-top: 0.35rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.55rem;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--ink);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.home__price-card-cta:hover {
		border-color: color-mix(in srgb, var(--magenta) 40%, var(--line-strong));
		background: color-mix(in srgb, var(--magenta) 8%, transparent);
		color: var(--magenta-soft);
	}

	.home__price-card-cta--solid {
		border-color: transparent;
		background: #fff;
		color: #09090b;
	}

	.home__price-card-cta--solid:hover {
		background: #e4e4e7;
		border-color: transparent;
		color: #09090b;
	}

	@media (max-width: 768px) {
		.home__about-pricing {
			max-width: 17rem;
			justify-self: start;
		}

		.home__about-pricing-grid {
			min-height: 0;
		}
	}
</style>
